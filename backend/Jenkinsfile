pipeline {
    agent any

    environment {
        BACKEND_IMAGE = 'ecocycle-backend:1.0'
        FRONTEND_IMAGE = 'ecocycle-frontend:1.0'
        KUBECONFIG = '/var/lib/jenkins/.kube/config'
        MINIKUBE_HOME = '/var/lib/jenkins/.minikube'
    }

    stages {

        stage('1. Checkout Code') {
            steps {
                echo 'Checking out EcoCycle source code...'
                checkout scm
            }
        }

        stage('2. Backend Build') {
            steps {
                dir('backend') {
                    echo 'Building Spring Boot backend...'
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('3. Backend Tests') {
            steps {
                dir('backend') {
                    echo 'Running JUnit tests...'
                    sh 'mvn test'
                }
            }
        }

        stage('4. Frontend Build') {
            steps {
                echo 'Building React frontend...'
                sh 'npm install'
                sh 'npm run build'
            }
        }

        stage('5. Security Check') {
            steps {
                dir('backend') {
                    echo 'Running dependency security check...'
                    sh 'mvn dependency:tree'
                }
            }
        }

        stage('6. Build Docker Images') {
            steps {
                echo 'Building backend Docker image...'
                sh 'docker build -t ${BACKEND_IMAGE} ./backend'

                echo 'Building frontend Docker image...'
                sh 'docker build -t ${FRONTEND_IMAGE} .'
            }
        }

        stage('7. Load Images into Minikube') {
            steps {
                echo 'Loading backend image into Minikube...'
                sh 'minikube image load ${BACKEND_IMAGE}'

                echo 'Loading frontend image into Minikube...'
                sh 'minikube image load ${FRONTEND_IMAGE}'
            }
        }

        stage('8. Deploy to Kubernetes') {
            steps {
                echo 'Deploying EcoCycle backend to Kubernetes...'
                sh 'kubectl apply -f k8s/backend.yaml'

                echo 'Deploying EcoCycle frontend to Kubernetes...'
                sh 'kubectl apply -f k8s/frontend.yaml'

                echo 'Restarting deployments to use the latest images...'
                sh 'kubectl rollout restart deployment/ecocycle-backend'
                sh 'kubectl rollout restart deployment/ecocycle-frontend'

                echo 'Waiting for backend deployment...'
                sh 'kubectl rollout status deployment/ecocycle-backend --timeout=120s'

                echo 'Waiting for frontend deployment...'
                sh 'kubectl rollout status deployment/ecocycle-frontend --timeout=120s'
            }
        }

        stage('9. Kubernetes Verification') {
            steps {
                echo 'Checking Kubernetes pods...'
                sh 'kubectl get pods -o wide'

                echo 'Checking Kubernetes services...'
                sh 'kubectl get services'

                echo 'Checking deployments...'
                sh 'kubectl get deployments'
            }
        }
    }

    post {
        always {
            echo 'EcoCycle Jenkins Kubernetes pipeline finished.'
        }

        success {
            echo 'SUCCESS: EcoCycle built, tested, containerized and deployed to Kubernetes.'
        }

        failure {
            echo 'FAILURE: Check the Jenkins console output for errors.'
        }
    }
}
